{
  "manifest_version": 3,
  "name": "Font Catcher",
  "version": "1.0.0",
  "description": "Heart fonts on Google Fonts and Fontshare, catch fonts from any website, and keep them all in one dashboard.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Font Catcher",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": ["storage", "unlimitedStorage", "activeTab", "scripting", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["https://fonts.google.com/*", "https://www.fontshare.com/*", "https://fontshare.com/*"],
      "js": ["src/content/site-hearts.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Open Font Catcher on the current page"
    }
  }
}
